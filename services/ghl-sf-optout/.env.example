# --- Salesforce auth: pick ONE ---

# Option A (easiest): Sfdx Auth Url from `sf org auth show-sfdx-auth-url --target-org rainmaker`
# Looks like force://PlatformCLI::<refreshToken>@<instance>.my.salesforce.com
SF_AUTH_URL=

# Option B: your own External Client App with the Client Credentials flow
SF_LOGIN_URL=https://improveit360-4020.my.salesforce.com
SF_CLIENT_ID=
SF_CLIENT_SECRET=

SF_API_VERSION=64.0

# Shared secret GHL must send, as header `x-webhook-secret: <value>` or `?key=<value>`.
# Leave blank to disable auth (don't do that in prod).
WEBHOOK_SECRET=

# Railway sets PORT for you
PORT=3000
