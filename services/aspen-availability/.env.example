# Aspen partner key (from Matthew). Server side only, never in the page.
ASPEN_API_KEY=
ASPEN_AVAILABILITY_URL=https://leadboard-mu.vercel.app/api/partner/availability

# Comma-separated page origins allowed to call /availability from the browser
ALLOWED_ORIGINS=https://vip.aspenwindows.com

# Same zip+product lookups share one Aspen call for this long
CACHE_SECONDS=60
# Per-visitor cap (the Aspen key is 10/min + 500/day for everyone combined)
PER_IP_PER_MIN=6

# Railway sets PORT for you
PORT=3000
